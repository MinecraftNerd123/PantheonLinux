  "version": 1,
  "workflows": {
   "align-camera": {
    "name": "Align camera",
    "steps": [
     {
      "action": "delay",
      "durationMs": 4000,
      "id": "settle",
      "name": "Let the spawn camera settle"
     },
     {
      "action": "if",
      "condition": {
       "checks": [
        {
         "state": "present",
         "target": "people-panel"
        }
       ],
       "operator": "all"
      },
      "elseSteps": [],
      "id": "close-people",
      "name": "Close the player list",
      "thenSteps": [
       {
        "action": "click-point",
        "button": "Left",
        "id": "click-people-x",
        "x": 563,
        "y": 73
       },
       {
        "action": "delay",
        "durationMs": 400,
        "id": "after-people"
       }
      ]
     },
     {
      "action": "call",
      "id": "setup-camera",
      "workflow": "camera-top-down"
     },
     {
      "action": "until",
      "condition": {
       "checks": [
        {
         "state": "present",
         "target": "minimap-arrow"
        }
       ],
       "operator": "all"
      },
      "failure": "error",
      "id": "align",
      "intervalMs": 100,
      "name": "Turn until the minimap arrow is exact",
      "steps": [
       {
        "action": "until",
        "condition": {
         "checks": [
          {
           "state": "present",
           "target": "minimap-arrow-wide"
          }
         ],
         "operator": "all"
        },
        "failure": "continue",
        "id": "coarse-sweep",
        "intervalMs": 100,
        "name": "Sweep until the minimap arrow is near default",
        "steps": [
         {
          "action": "rotate",
          "dx": 60,
          "dy": 0,
          "id": "coarse-turn"
         }
        ],
        "timeoutMs": 40000
       },
       {
        "action": "if",
        "condition": {
         "checks": [
          {
           "state": "present",
           "target": "minimap-arrow-wide"
          }
         ],
         "operator": "all"
        },
        "elseSteps": [
         {
          "action": "call",
          "id": "redo-camera",
          "workflow": "camera-top-down"
         }
        ],
        "id": "near",
        "name": "Fine turn when the arrow is near default",
        "thenSteps": [
         {
          "action": "until",
          "condition": {
           "checks": [
            {
             "state": "present",
             "target": "minimap-arrow"
            }
           ],
           "operator": "all"
          },
          "failure": "continue",
          "id": "fine",
          "intervalMs": 100,
          "name": "Turn until the minimap arrow is exact",
          "steps": [
           {
            "action": "rotate",
            "dx": 10,
            "dy": 0,
            "id": "fine-turn"
           }
          ],
          "timeoutMs": 15000
         },
         {
          "action": "if",
          "condition": {
           "checks": [
            {
             "state": "absent",
             "target": "minimap-arrow"
            }
           ],
           "operator": "all"
          },
          "elseSteps": [],
          "id": "false-near",
          "name": "Redo the camera and move past a false near match",
          "thenSteps": [
           {
            "action": "call",
            "id": "reset-camera",
            "workflow": "camera-top-down"
           },
           {
            "action": "rotate",
            "dx": 210,
            "dy": 0,
            "id": "skip-false"
           }
          ]
         }
        ]
       }
      ],
      "timeoutMs": 180000
     },
     {
      "action": "rotate",
      "dx": 15,
      "dy": 0,
      "id": "center"
     }
    ]
   },
   "camera-top-down": {
    "name": "Top-down camera",
    "steps": [
     {
      "action": "camera",
      "id": "top-down",
      "tilt": 299,
      "zoomIn": 40,
      "zoomOut": 25
     },
     {
      "action": "rotate",
      "dx": 0,
      "dy": 400,
      "id": "steepen"
     },
     {
      "action": "rotate",
      "dx": -150,
      "dy": 0,
      "id": "back-off"
     }
    ]
   },
   "finish-match": {
    "name": "Finish match",
    "steps": [
     {
      "action": "wait",
      "condition": {
       "checks": [
        {
         "state": "present",
         "target": "defeat"
        },
        {
         "state": "present",
         "target": "next-button"
        },
        {
         "state": "present",
         "target": "replay"
        }
       ],
       "operator": "any"
      },
      "id": "wait-defeat",
      "missing": "error",
      "name": "Wait for the end screen",
      "timeoutMs": 3600000
     },
     {
      "action": "if",
      "condition": {
       "checks": [
        {
         "state": "present",
         "target": "defeat"
        },
        {
         "state": "present",
         "target": "next-button"
        }
       ],
       "operator": "any"
      },
      "elseSteps": [],
      "id": "on-defeat",
      "name": "Count the result and gems on the Defeat screen",
      "thenSteps": [
       {
        "action": "if-number",
        "elseSteps": [
         {
          "action": "count-result",
          "id": "count-loss",
          "result": "loss"
         }
        ],
        "filter": "none",
        "height": 26,
        "id": "reached-30",
        "min": 30,
        "thenSteps": [
         {
          "action": "count-result",
          "id": "count-win",
          "result": "win"
         }
        ],
        "width": 110,
        "x": 330,
        "y": 296
       },
       {
        "action": "tally",
        "counter": "Gems",
        "filter": "light",
        "height": 26,
        "id": "count-gems",
        "width": 86,
        "x": 112,
        "y": 80
       }
      ]
     },
     {
      "action": "until",
      "condition": {
       "checks": [
        {
         "state": "present",
         "target": "replay"
        }
       ],
       "operator": "all"
      },
      "failure": "error",
      "id": "to-replay",
      "intervalMs": 900,
      "name": "Click through the end screens",
      "steps": [
       {
        "action": "if",
        "condition": {
         "checks": [
          {
           "state": "present",
           "target": "defeat"
          },
          {
           "state": "present",
           "target": "next-button"
          }
         ],
         "operator": "any"
        },
        "elseSteps": [
         {
          "action": "click-point",
          "button": "Left",
          "id": "click-reward",
          "x": 400,
          "y": 330
         }
        ],
        "id": "next-if-defeat",
        "name": "Click Next",
        "thenSteps": [
         {
          "action": "click-point",
          "button": "Left",
          "id": "click-next",
          "x": 320,
          "y": 395
         }
        ]
       }
      ],
      "timeoutMs": 90000
     },
     {
      "action": "click",
      "button": "Left",
      "id": "click-replay",
      "missing": "error",
      "target": "replay",
      "timeoutMs": 5000
     },
     {
      "action": "until",
      "condition": {
       "checks": [
        {
         "state": "absent",
         "target": "replay"
        }
       ],
       "operator": "all"
      },
      "failure": "continue",
      "id": "after-replay",
      "intervalMs": 500,
      "name": "Wait for Replay to go away",
      "steps": [],
      "timeoutMs": 20000
     }
    ]
   },
   "force-lose": {
    "name": "Vote to lose until the match ends",
    "steps": [
     {
      "action": "retry",
      "attempts": 8,
      "condition": {
       "checks": [
        {
         "state": "present",
         "target": "defeat"
        },
        {
         "state": "present",
         "target": "next-button"
        },
        {
         "state": "present",
         "target": "replay"
        }
       ],
       "operator": "any"
      },
      "failure": "error",
      "id": "vote-until-end",
      "intervalMs": 1000,
      "name": "Vote to lose until an end screen shows",
      "steps": [
       {
        "action": "call",
        "id": "attempt",
        "workflow": "vote-lose"
       }
      ],
      "timeoutMs": 10000
     }
    ]
   },
   "main": {
    "name": "Main sequence",
    "steps": [
     {
      "action": "call",
      "id": "start",
      "workflow": "start-match"
     },
     {
      "action": "call",
      "id": "place",
      "workflow": "place-units"
     },
     {
      "action": "until",
      "condition": {
       "checks": [
        {
         "state": "present",
         "target": "wave-30"
        },
        {
         "state": "present",
         "target": "defeat"
        },
        {
         "state": "present",
         "target": "next-button"
        },
        {
         "state": "present",
         "target": "replay"
        }
       ],
       "operator": "any"
      },
      "failure": "continue",
      "id": "wait-early",
      "intervalMs": 2000,
      "name": "Wait for wave 30 (first 12 minutes)",
      "steps": [
       {
        "action": "call",
        "id": "skip-early",
        "workflow": "skip-wave"
       }
      ],
      "timeoutMs": 720000
     },
     {
      "action": "until",
      "condition": {
       "checks": [
        {
         "state": "present",
         "target": "wave-30"
        },
        {
         "state": "present",
         "target": "defeat"
        },
        {
         "state": "present",
         "target": "next-button"
        },
        {
         "state": "present",
         "target": "replay"
        }
       ],
       "operator": "any"
      },
      "failure": "continue",
      "id": "wait-wave",
      "intervalMs": 2000,
      "name": "Wait for wave 30 or a wave counter of 31+ (forced at 25 minutes)",
      "steps": [
       {
        "action": "call",
        "id": "skip",
        "workflow": "skip-wave"
       },
       {
        "action": "if-number",
        "elseSteps": [],
        "filter": "none",
        "height": 32,
        "id": "wave-guard",
        "min": 31,
        "thenSteps": [
         {
          "action": "call",
          "id": "guard-lose",
          "workflow": "force-lose"
         }
        ],
        "width": 120,
        "x": 150,
        "y": 52
       }
      ],
      "timeoutMs": 780000
     },
     {
      "action": "if",
      "condition": {
       "checks": [
        {
         "state": "present",
         "target": "defeat"
        },
        {
         "state": "present",
         "target": "next-button"
        },
        {
         "state": "present",
         "target": "replay"
        }
       ],
       "operator": "any"
      },
      "elseSteps": [
       {
        "action": "call",
        "id": "lose-now",
        "workflow": "force-lose"
       }
      ],
      "id": "lose",
      "name": "Vote to lose unless the match already ended",
      "thenSteps": []
     },
     {
      "action": "call",
      "id": "finish",
      "workflow": "finish-match"
     }
    ]
   },
   "place-units": {
    "name": "Place units",
    "steps": [
     {
      "action": "rotate",
      "dx": 0,
      "dy": 400,
      "id": "re-steepen"
     },
     {
      "action": "placements",
      "fallback": "error",
      "id": "place",
      "route": "walled-city-takedowns"
     }
    ]
   },
   "recover": {
    "name": "Recover after an error",
    "steps": [
     {
      "action": "if",
      "condition": {
       "checks": [
        {
         "state": "present",
         "target": "unit-panel"
        }
       ],
       "operator": "all"
      },
      "elseSteps": [],
      "id": "close-panel",
      "name": "Close an open unit panel",
      "thenSteps": [
       {
        "action": "click-point",
        "button": "Left",
        "id": "click-panel-x",
        "x": 277,
        "y": 227
       },
       {
        "action": "delay",
        "durationMs": 300,
        "id": "after-panel-x"
       }
      ]
     },
     {
      "action": "if",
      "condition": {
       "checks": [
        {
         "state": "present",
         "target": "vote-start"
        },
        {
         "state": "present",
         "target": "defeat"
        },
        {
         "state": "present",
         "target": "next-button"
        },
        {
         "state": "present",
         "target": "replay"
        }
       ],
       "operator": "any"
      },
      "elseSteps": [
       {
        "action": "call",
        "id": "end-match",
        "workflow": "force-lose"
       }
      ],
      "id": "in-match",
      "name": "End the match if one is running",
      "thenSteps": []
     }
    ]
   },
   "skip-wave": {
    "name": "Skip wave",
    "steps": [
     {
      "action": "if",
      "condition": {
       "checks": [
        {
         "state": "present",
         "target": "skip-wave"
        }
       ],
       "operator": "all"
      },
      "elseSteps": [],
      "id": "skip-if-shown",
      "name": "Vote to skip the wave",
      "thenSteps": [
       {
        "action": "click-point",
        "button": "Left",
        "id": "click-skip",
        "x": 638,
        "y": 263
       },
       {
        "action": "delay",
        "durationMs": 1000,
        "id": "after-skip"
       }
      ]
     }
    ]
   },
   "start-match": {
    "name": "Start match",
    "steps": [
     {
      "action": "until",
      "condition": {
       "checks": [
        {
         "state": "present",
         "target": "vote-start"
        }
       ],
       "operator": "all"
      },
      "failure": "continue",
      "id": "reach-vote",
      "intervalMs": 1000,
      "name": "Get to the vote screen",
      "steps": [
       {
        "action": "if",
        "condition": {
         "checks": [
          {
           "state": "present",
           "target": "unit-panel"
          }
         ],
         "operator": "all"
        },
        "elseSteps": [],
        "id": "close-panel",
        "name": "Close an open unit panel",
        "thenSteps": [
         {
          "action": "click-point",
          "button": "Left",
          "id": "click-panel-x",
